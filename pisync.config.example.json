{
  "listen": { "host": "127.0.0.1", "port": 7878 },

  "upstreams": {
    "anthropic": "https://api.anthropic.com",
    "openai-codex": "https://chatgpt.com/backend-api",
    "openai": "https://api.openai.com/v1"
  },

  "queue": {
    "maxWaitMs": 10800000,
    "parentResume": "front",
    "maxRequestBodyBytes": 268435456
  },

  "task": {
    "maxDurationMs": 10800000,
    "onMaxDuration": "requeue",
    "activeIdleTimeoutMs": 0,
    "implicitIdleMs": 2000
  },

  "agent": { "leaseMs": 30000, "pollMs": 20000 },

  "retry": {
    "maxRetries": 25,
    "baseDelayMs": 1000,
    "maxDelayMs": 30000,
    "jitter": 0.2,
    "retryAfterMaxMs": 300000,
    "statuses": [408, 409, 425, 429, 500, 502, 503, 504, 520, 521, 522, 523, 524, 529],
    "sniffStreamErrors": true
  },

  "timeouts": {
    "connectMs": 30000,
    "headersMs": 300000,
    "idleMs": 120000,
    "requestMs": 1800000
  },

  "logLevel": "info"
}
